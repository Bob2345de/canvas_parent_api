    async def get_module_progress(self, child_name: str = "", course_name: str = "") -> str:
        """
        Show each child's progress through course modules/units (completed, in progress, locked).
        Use for "is X keeping up with the coursework?" or "how far along is X in the unit?"

        :param child_name: Optional name of a specific child. Leave empty for all children.
        :param course_name: Optional course name to limit results to one class.
        """
        students, error = await self._get_filtered_students(child_name)
        if error:
            return error

        client = self._get_client()
        state_icons = {"completed": "✅", "started": "🔄", "unlocked": "⬜", "locked": "🔒"}
        results = []
        errors = []

        for student in students:
            results.append(f"\n📚 **Module Progress for {student.name}**")
            courses, err = await self._get_filtered_courses(student, course_name)
            if err:
                errors.append(err)
                continue
            for course in courses:
                try:
                    modules = await client.modules(course.id, student.id)
                except Exception as e:
                    errors.append(f"Error fetching modules for {course.name}: {e}")
                    continue
                if not modules:
                    continue
                results.append(f"  📘 **{course.name}**:")
                completed = sum(1 for m in modules if m.state == "completed")
                results.append(f"    Progress: {completed}/{len(modules)} modules completed")
                for m in sorted(modules, key=lambda x: x.position or 0):
                    icon = state_icons.get(m.state or "", "⬜")
                    count = f" ({m.items_count} items)" if m.items_count else ""
                    done = (
                        f" — completed {self._fmt_dt(m.completed_at, with_time=False)}"
                        if m.completed_at
                        else ""
                    )
                    results.append(f"    {icon} {m.name}{count}{done}")

        if errors:
            results.append("\n⚠️ **Some data could not be retrieved:**")
            results.extend(f"  - {e}" for e in errors)
        return "\n".join(results)
    async def get_recent_activity(self, hours_back: int = 24) -> str:
        """
        Get a chronological feed of recent Canvas activity across all children:
        new grades, announcements, submissions, discussions, and messages.
        Use for "what happened today?" or "give me a quick Canvas update."

        :param hours_back: How many hours of activity to show (default: 24)
        """
        client = self._get_client()
        try:
            items = await client.activity_stream()
        except Exception as e:
            return f"❌ Error fetching activity stream: {e}"

        cutoff = datetime.now(timezone.utc) - timedelta(hours=hours_back)
        recent = []
        for item in items:
            dt = self._parse_date(item.updated_at or item.created_at)
            if dt and dt >= cutoff:
                recent.append((dt, item))

        if not recent:
            return f"ℹ️ No Canvas activity in the last {hours_back} hours."

        type_icons = {
            "Announcement": "📢",
            "Submission": "📝",
            "DiscussionTopic": "💬",
            "Conversation": "✉️",
            "Message": "✉️",
            "Conference": "🎥",
            "Collaboration": "🤝",
            "AssessmentRequest": "📋",
        }
        lines = [f"🕐 **Canvas activity in the last {hours_back} hours:**"]
        for dt, item in sorted(recent, key=lambda x: x[0], reverse=True):
            icon = type_icons.get(item.type or "", "•")
            title = item.title or "(no title)"
            lines.append(f"  {icon} [{dt.strftime('%b %d %I:%M %p')}] **{title}**")
            msg = self._strip_html(item.message, max_len=200)
            if msg:
                lines.append(f"      {msg}")
        return "\n".join(lines)

    async def get_daily_summary(self, child_name: str = "") -> str:
        """
        One-stop daily dashboard: combines current grades, work due in the next 3 days,
        missing assignments, and yesterday-to-now activity for each child.
        Use for open-ended requests like "how are the kids doing?" or "morning Canvas report."

        :param child_name: Optional name of a specific child. Leave empty for all children.
        """
        sections = await asyncio.gather(
            self.get_current_grades(child_name),
            self.get_upcoming_assignments(days_ahead=3, child_name=child_name),
            self.get_missing_assignments(child_name),
            self.get_recent_activity(hours_back=24),
            return_exceptions=True,
        )
        headers = (
            "═══ 📊 CURRENT GRADES ═══",
            "═══ 📅 DUE IN THE NEXT 3 DAYS ═══",
            "═══ 🚨 MISSING WORK ═══",
            "═══ 🕐 LAST 24 HOURS ═══",
        )
        parts = []
        for header, section in zip(headers, sections):
            parts.append(f"\n{header}")
            if isinstance(section, Exception):
                parts.append(f"⚠️ This section failed: {section}")
            else:
                parts.append(section)
        return "\n".join(parts)

